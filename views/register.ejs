<%- include('partials/header') %>
<div class="auth-fx" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
<div class="glass-frame">
  <div class="glass-bar" aria-hidden="true">
    <span class="glass-dot"></span><span class="glass-dot"></span><span class="glass-dot"></span>
    <span class="glass-bar-title"><%= settings.panel_name %> control panel</span>
  </div>
  <div class="panel card-auth">
    <div class="brand-lg"><span class="lamp running"></span><%= settings.panel_name %></div>
    <h1>Create account</h1>
    <% if (error) { %><div class="note err" role="alert" style="margin-top:1rem"><%= error %></div><% } %>
    <form method="post" action="/register" style="margin-top:1rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="username">Username</label><input id="username" name="username" type="text" autocomplete="username" required></div>
      <div class="field"><label for="email">Email (optional)</label><input id="email" name="email" type="email" autocomplete="email"></div>
      <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required><div class="hint">At least 8 characters.</div></div>
      <button class="btn primary" type="submit" style="width:100%;justify-content:center">Create account</button>
    </form>
    <p class="small muted" style="margin:1rem 0 0">Already registered? <a href="/login">Sign in</a>.</p>
  </div>
</div>
<%- include('partials/footer') %>
